PROJECT_NAME="Tech Vision Telegram Bot"
VERSION="1.0.0"
DEBUG=True

# Database Credentials & Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="tele_bot"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tele_bot"

# Telegram & JWT Authentication
BOT_TOKEN="your_telegram_bot_token_here"
JWT_SECRET="supersecretjwtkey_change_me_in_production_123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins
CORS_ORIGINS=["*"]
